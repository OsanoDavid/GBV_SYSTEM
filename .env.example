# Django Settings
DJANGO_SECRET_KEY=your-django-secret-key-here
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Email Configuration
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=SafeSpace System <no-reply@safespace.org>

# For Production: Gmail App Password
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-16-char-app-password

# Africa's Talking SMS
AFRICASTALKING_USERNAME=sandbox
SMS_API_URL=https://api.africastalking.com/version1/messaging
SMS_API_KEY=your-africastalking-api-key-here
SMS_SENDER_ID=SafeSpace

# Security
SECURE_SSL_REDIRECT=False
